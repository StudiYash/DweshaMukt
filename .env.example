# Optional local configuration for Project Frontend.
# Copy this file to .env and fill only the values you need.

# Required only for YouTube comment classification.
YOUTUBE_API_KEY=

# Required only for GIF text detection with Google Cloud Video Intelligence.
# Use an absolute path, or a path relative to the repository root.
GOOGLE_APPLICATION_CREDENTIALS=

# Required only for image OCR if tesseract is not available on PATH.
# Prefer adding tesseract to PATH. If needed, use a local or machine-specific
# path in your private .env file.
TESSERACT_CMD=

# Required only for Telegram bot notebooks.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
